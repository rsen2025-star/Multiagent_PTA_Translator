
sp {train*init
    (state <s> ^superstate nil)
-->
    (<s> ^position far ^train-count 0)
}

# ── Proposals ─────────────────────────────────────────────────────────────────

# Clock: count < travel-delay, keep ticking
sp {train*propose*clock
    (state <s> ^train-count { <c> < <delay> }
               ^io.input-link.travel-delay <delay>)
-->
    (<s> ^operator <o> +)
    (<o> ^name clock)
}

# Transition far→near: count reached travel-delay
sp {train*propose*approach
    (state <s> ^position far
               ^train-count { <c> >= <delay> }
               ^io.input-link.travel-delay <delay>)
-->
    (<s> ^operator <o> +)
    (<o> ^name approach)
}

# Transition near→in: count reached travel-delay
sp {train*propose*enter
    (state <s> ^position near
               ^train-count { <c> >= <delay> }
               ^io.input-link.travel-delay <delay>)
-->
    (<s> ^operator <o> +)
    (<o> ^name enter)
}

# Transition in→far: count reached travel-delay
sp {train*propose*exit
    (state <s> ^position in
               ^train-count { <c> >= <delay> }
               ^io.input-link.travel-delay <delay>)
-->
    (<s> ^operator <o> +)
    (<o> ^name exit)
}

# ── Output-link cleanup ───────────────────────────────────────────────────────

# sp {train*clear*output
#     (state <s> ^operator <o> ^io.output-link <out>)
#     (<out> ^<attr> <val>)
# -->
#     (<out> ^<attr> <val> -)
# }

# ── Apply rules ───────────────────────────────────────────────────────────────

sp {train*apply*clock
    (state <s> ^operator <o> ^train-count <c>)
    (<o> ^name clock)
-->
    (<s> ^train-count <c> -)
    (<s> ^train-count (+ <c> 1))
}

sp {train*apply*approach
    (state <s> ^operator <o>
               ^position far
               ^train-count { <c> >= <delay> }
               ^io.input-link.travel-delay <delay>
               ^io.output-link <out>)
    (<o> ^name approach)
-->
    (<s> ^position far -)
    (<s> ^position near +)
    (<s> ^train-count <c> -)
    (<s> ^train-count 0 +)
    (<out> ^signal approach)
}

sp {train*apply*enter
    (state <s> ^operator <o>
               ^position near
               ^train-count { <c> >= <delay> }
               ^io.input-link.travel-delay <delay>)
    (<o> ^name enter)
-->
    (<s> ^position near -)
    (<s> ^position in +)
    (<s> ^train-count <c> -)
    (<s> ^train-count 0 +)
}

sp {train*apply*exit
    (state <s> ^operator <o>
               ^position in
               ^train-count { <c> >= <delay> }
               ^io.input-link.travel-delay <delay>
               ^io.output-link <out>)
    (<o> ^name exit)
-->
    (<s> ^position in -)
    (<s> ^position far +)
    (<s> ^train-count <c> -)
    (<s> ^train-count 0 +)
    (<out> ^signal exit)
}
